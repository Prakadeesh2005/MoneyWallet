<Window x:Class="MoneyWallet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoneyWallet"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen" Background="#F4F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <TextBlock Text="MoneyWallet" FontSize="30" FontWeight="Bold" Foreground="#243B53"/>
            <TextBlock x:Name="lblUsername" Text="Welcome, User" FontSize="16" Margin="0,5,0,20" Foreground="#526777"/>
            <!-- Expense Summary -->

            <TextBlock Text="Expense Summary" FontSize="22" FontWeight="Bold" Margin="0,5,0,12"/>
            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="This Month" FontSize="16"/>
                        <TextBlock x:Name="lblMonthly" Text="₹ 0.00" FontSize="24" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="This Week" FontSize="16"/>
                        <TextBlock x:Name="lblWeekly" Text="₹ 0.00" FontSize="24" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock x:Name="lblYearTitle" Text="Current Year" FontSize="16"/>
                        <TextBlock x:Name="lblYearly" Text="₹ 0.00" FontSize="24" FontWeight="Bold" Foreground="#EA580C"/>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Add Expense -->

            <Border Background="White" CornerRadius="10" Padding="20" Margin="5">
                <StackPanel>
                    <TextBlock Text="Add New Expense" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Reason"/>
                    <TextBox x:Name="txtReason" Height="35" Margin="0,5,0,12"/>
                    <TextBlock Text="Date"/>
                    <DatePicker x:Name="dpExpenseDate" Height="35" Margin="0,5,0,12"/>
                    <TextBlock Text="Amount"/>
                    <TextBox x:Name="txtAmount" Height="35" Margin="0,5,0,15"/>
                    <Button x:Name="btnSave" Content="Save Expense" Height="40" Width="160" HorizontalAlignment="Left" Background="#2563EB" Foreground="White" FontWeight="Bold" Click="btnSave_Click"/>
                </StackPanel>
            </Border>
            <!-- Expense List -->

            <TextBlock Text="My Expenses" FontSize="22" FontWeight="Bold" Margin="5,25,5,10"/>
            <DataGrid x:Name="dgExpenses" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="250" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EID" Binding="{Binding eid}" Width="70"/>
                    <DataGridTextColumn Header="Reason" Binding="{Binding reason}" Width="*"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding date, StringFormat={}{0:dd-MM-yyyy}}" Width="150"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding amount, StringFormat={}{0:N2}}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</Window>
