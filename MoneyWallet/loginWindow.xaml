<Window x:Class="MoneyWallet.loginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoneyWallet"
        mc:Ignorable="d"
        Title="loginWindow" Height="650" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F4F6FA">

    <Border Background="White" CornerRadius="15" Padding="25" Margin="15">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <TextBlock Text="MoneyWallet" FontSize="30" FontWeight="Bold" Foreground="#243B53" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Login to your account" FontSize="17" Foreground="#526777" HorizontalAlignment="Center" Margin="0,0,0,30"/>
            <TextBlock Text="Email" FontWeight="SemiBold"/>
            <TextBox x:Name="txtEmail" Height="38" Margin="0,8,0,18"/>
            <TextBlock Text="Password" FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtPassword" Height="38" Margin="0,8,0,25"/>
            <Button x:Name="btnLogin" Content="Login" Height="42" Background="#2563EB" Foreground="White" FontWeight="Bold" Click="btnLogin_Click"/>
            <TextBlock Text="Don't have an account?" HorizontalAlignment="Center" Margin="0,25,0,8"/>
            <Button x:Name="btnRegister" Content="Create Account / Register" Height="38" Background="#E8EEF9" Foreground="#243B53" Click="btnRegister_Click"/>
        </StackPanel>
    </Border>
</Window>

